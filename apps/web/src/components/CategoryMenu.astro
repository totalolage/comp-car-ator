---
/**
 * The category tree as a header disclosure: body types and a link to every make and model
 * (CategoryIndex), plus the person's recently viewed models (filled in by scripts/shell.ts).
 * Plain links and <details>, so it works before and without JavaScript; links prefetch on
 * hover. Makes and models come from the categories page once the menu is about to open
 * (scripts/shell.ts).
 */
import { i18n } from "../i18n/i18n.ts";
import type { Lang } from "../i18n/messages.ts";
import type { CategoryTree } from "../lib/catalog.ts";
import CategoryIndex from "./CategoryIndex.astro";

interface Props {
  lang: Lang;
  tree: CategoryTree;
}
const { lang, tree } = Astro.props;
const t = i18n(lang);
---
<details class="menu" data-menu>
  <summary class="masthead-link">{t.t("nav.categories")}</summary>
  <div class="menu-panel categories">
    <section class="menu-recents" data-recents hidden>
      <h2>{t.t("nav.recents")}</h2>
      <ul></ul>
    </section>
    <CategoryIndex lang={lang} tree={tree} menu />
  </div>
</details>
