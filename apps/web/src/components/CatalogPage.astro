---
import { i18n } from "../i18n/i18n.ts";
import type { Lang } from "../i18n/messages.ts";
import Base from "../layouts/Base.astro";
import { buildCatalog } from "../lib/catalog.ts";
import CatalogExplorer from "./CatalogExplorer.tsx";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = i18n(lang);
const catalog = await buildCatalog();
const initial = catalog.query({ sort: { key: "make", dir: "asc" }, limit: 200 });
const makeNames = Object.fromEntries(
  catalog.query({ limit: Number.MAX_SAFE_INTEGER }).rows.map((v) => [v.makeId, v.make]),
);
---
<Base lang={lang} path="/">
  <h1 class="page-title">{t.t("catalog.heading")}</h1>
  <CatalogExplorer client:load lang={lang} initial={initial} makeNames={makeNames} />
</Base>
