---
/**
 * The site shell every page renders in: skip link, header with the category menu, compare
 * link and language switch, optional breadcrumb, main content, data footer, and the compare
 * tray. Pages fill the default slot; the catalog page lays out its own facet rail with the
 * `.split` layout from styles/base.css.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import CategoryMenu from "../components/CategoryMenu.astro";
import CompareTray from "../components/CompareTray.astro";
import { i18n } from "../i18n/i18n.ts";
import type { Lang } from "../i18n/messages.ts";
import { categoryTree } from "../lib/catalog.ts";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title?: string;
  /** Path of this page without the locale prefix, for the language switch and hreflang. */
  path: string;
  /** Trail below the header; the catalog root is prepended. */
  crumbs?: Crumb[];
  /** Remembered as a recently viewed model when set. */
  recent?: { id: string; label: string };
  /** The compare page shows the list itself and leaves the tray out. */
  tray?: boolean;
  /** Kept out of search results (the offline page). */
  noindex?: boolean;
}
const { lang, title, path, crumbs, recent, tray = true, noindex = false } = Astro.props;
const t = i18n(lang);
const other: Lang = lang === "cs" ? "en" : "cs";
const tree = await categoryTree();
const site = t.t("site.title");
const trail: Crumb[] | undefined = crumbs && [
  { label: t.t("nav.catalog"), href: t.path("/") },
  ...crumbs,
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={t.t("site.tagline")} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={site} />
    {/* Installed on iOS the status bar sits over the page; the masthead's green runs under it. */}
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#00664a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c5240" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" hreflang="cs" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site)} />
    <title>{title ? `${title} – ${site}` : `${site} – ${t.t("site.tagline")}`}</title>
  </head>
  <body data-lang={lang} data-recent-id={recent?.id} data-recent-label={recent?.label}>
    <a class="skip" href="#main">{t.t("nav.skip")}</a>
    <header class="masthead">
      <div class="masthead-bar">
        <a class="wordmark" href={t.path("/")}>
          <svg viewBox="0 0 480 299" width="26" height="16" fill="currentColor" aria-hidden="true">
            <path d="M0 197V129A53 53 0 0 1 53 76L116 76L154 10A21 21 0 0 1 172 0H284A21 21 0 0 1 299 6L369 76H427A53 53 0 0 1 480 129V197H438V129A11 11 0 0 0 427 118H360A21 21 0 0 1 345 112L275 42L184 42L146 108A21 21 0 0 1 128 118H53A11 11 0 0 0 42 129V197ZM194 216H270V258H194ZM174 196A62 62 0 1 0 174 278L143 250A20 20 0 1 1 143 224ZM398 196A62 62 0 1 0 398 278L367 250A20 20 0 1 1 367 224Z" />
          </svg>
          <span class="wordmark-name">{site}</span>
        </a>
        <CategoryMenu lang={lang} tree={tree} />
        <span class="masthead-fill"></span>
        <a class="masthead-link" href={t.path("/compare/")} data-compare-link hidden>
          {t.t("nav.compare")} <span class="badge" data-compare-count>0</span>
        </a>
        <a
          class="masthead-link lang"
          href={other === "cs" ? path : `/en${path}`}
          hreflang={other}
          lang={other}
          title={t.t("lang.switchLabel")}
          data-lang-switch={other}
        >{t.t("lang.switch")}</a>
      </div>
    </header>
    {
      trail && (
        <nav class="crumbs" aria-label={t.t("nav.breadcrumb")}>
          <ol>
            {trail.map((c, i) => (
              <li>
                {c.href && i < trail.length - 1 ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="colophon">
      <p>
        {t.t("footer.data", { date: t.date(tree.generatedAt) })}:{" "}
        {t.t("footer.counts", {
          variants: t.count("count.variants", tree.variants),
          listings: t.count("count.listings", tree.listings),
        })}.
      </p>
      <p>{t.t("footer.note")}</p>
    </footer>
    {tray && <CompareTray lang={lang} />}
    <script>
      import "../scripts/shell.ts";
    </script>
  </body>
</html>
